# AI Phishing Awareness Campaign Kit - Configuration
# NOTE: The application works completely out-of-the-box without an API key.
# A transparent, rule-based heuristic analyzer is used by default.

# Flask Application Settings
FLASK_ENV=development
FLASK_PORT=5000
FLASK_DEBUG=True

# Optional External AI Integration
# If provided, the analyzer can query an LLM provider while keeping the API key strictly server-side.
# If omitted or left blank, the app runs in transparent "Demo Heuristic Mode".
AI_PROVIDER=none # Options: none, gemini, openai
GEMINI_API_KEY=
OPENAI_API_KEY=

